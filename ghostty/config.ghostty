# 1. Performance & Display
font-family = "JetBrainsMono Nerd Font Mono"
theme = TokyoNight Storm
font-size = 14

# `bold-is-bright` only swaps an already-coloured glyph for its bright variant,
# so bold text drawn in the DEFAULT foreground had no brighter version to swap
# to and stayed the same colour. Naming an explicit colour is the form that
# applies to default-foreground bold, which is what TUIs use for headings.
bold-color = #e0af68
font-style-bold = ExtraBold

# Line spacing. Helps the eye find the start of the next line on long lines.
adjust-cell-height = 12%

macos-titlebar-style = hidden
window-padding-x = 15
window-padding-y = 15
background-opacity = 1.00
background-blur-radius = 0

confirm-close-surface = always
shell-integration-features = true
auto-update = off

macos-option-as-alt = true

copy-on-select = "clipboard"
clipboard-trim-trailing-spaces = true
